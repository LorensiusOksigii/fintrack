# ================================
# FinTrack Backend — Environment
# ================================
# Salin file ini ke .env untuk development lokal.
# Jangan commit .env ke Git!

# --- App ---
DEBUG=true

# --- Database ---
# Development lokal (via Docker Compose):
DATABASE_URL=postgresql://fintrack_user:fintrack_password@localhost:5432/fintrack_db
# Production (Neon):
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# --- JWT ---
# Generate secret key yang kuat:
#   Python: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# Origins yang diizinkan (pisahkan dengan koma, tanpa spasi)
ALLOWED_ORIGINS=http://localhost:5173
