# ================================
# FinTrack Docker — Environment
# ================================
# Salin file ini ke .env di folder yang sama (docker/.env).
# File .env TIDAK boleh di-commit ke Git.

# --- PostgreSQL ---
POSTGRES_USER=fintrack_user
POSTGRES_PASSWORD=fintrack_password
POSTGRES_DB=fintrack_db
POSTGRES_PORT=5432

# --- pgAdmin (opsional, jalankan dengan --profile tools) ---
PGADMIN_EMAIL=admin@fintrack.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
